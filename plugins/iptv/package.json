{
  "name": "@local/iptv",
  "version": "1.2.0",
  "description": "An IPTV panel: load M3U/M3U8 playlists, browse channels by group, search, favorite, and watch live HLS streams in the panel.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/elanchou/dsh-life-panels.git",
    "directory": "plugins/iptv"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "m3u.js",
    "proxy.js",
    "merge.js",
    "common.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "vendor/*",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
