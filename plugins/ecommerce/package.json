{
  "name": "@local/ecommerce",
  "version": "1.0.0",
  "description": "Cross-border e-commerce back office: products with real landed cost, per-market listing profit, orders with their own cost and exchange rate, supplier purchases that restock, profit and loss, and restock advice from the real sales rate.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/elanchou/dsh-life-panels.git",
    "directory": "plugins/ecommerce"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js", "calc.js", "csv.js", "model.js", "orders.js", "ops-orders.js", "ops-products.js", "rates.js", "reports.js", "util.js",
    "merge.js", "common.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
