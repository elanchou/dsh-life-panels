{
  "name": "@local/market",
  "version": "2.0.3",
  "description": "Global markets: a 3D globe of the world exchanges with live open/closed state, world indices, commodities, currencies, crypto, and a watchlist of US and Hong Kong stocks and coins with optional positions. Delayed public quotes, no account or API key.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/elanchou/dsh-life-panels.git",
    "directory": "plugins/market"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "quote.js",
    "merge.js",
    "common.js",
    "client.js",
    "vendor/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
