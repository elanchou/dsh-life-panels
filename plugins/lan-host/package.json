{
  "name": "@local/lan-host",
  "version": "1.0.1",
  "description": "Serve the life panels to an iPad or another device on the local network: scan a QR code to pair, then use the same panels in its browser. Cloud sync and iCafe are never exposed.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/elanchou/dsh-life-panels.git",
    "directory": "plugins/lan-host"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "server.js",
    "qr.js",
    "merge.js",
    "common.js",
    "client.js",
    "web/*",
    "vendor/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
